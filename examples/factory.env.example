# Install as /etc/factory/<repo>.env, mode 600, owned by the factory user.
# Literal KEY=value entries only: no quotes, export, escapes, or substitutions.
FACTORY_IMAGE=factory-target:v0.1.0
GH_TOKEN=replace-with-repository-scoped-token
ANTHROPIC_API_KEY=replace-with-selected-provider-key
# For harness = "codex", replace ANTHROPIC_API_KEY with CODEX_API_KEY.
FACTORY_GIT_NAME=Software Factory
FACTORY_GIT_EMAIL=replace-with-factory-commit-email
