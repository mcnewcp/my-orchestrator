#!/usr/bin/env bash
set -euo pipefail

fail() { printf 'factory-host: %s\n' "$*" >&2; exit 1; }
[[ $# -ge 2 ]] || fail 'usage: factory-host <repo> <factory args...>'
task_repo=$1
shift
[[ "$task_repo" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && ${#task_repo} -le 64 ]] \
    || fail 'repo must be a simple name of at most 64 characters'

task_uid=$(id -u)
task_gid=$(id -g)
[[ "$task_uid" != 0 ]] || fail 'run as the dedicated non-root factory user'
task_env_file="/etc/factory/${task_repo}.env"
task_mount="/srv/factory/${task_repo}"
[[ -f "$task_env_file" && -r "$task_env_file" ]] || fail "cannot read $task_env_file"
[[ "$(stat -c '%a:%u' -- "$task_env_file")" == "600:${task_uid}" ]] \
    || fail 'env file must have mode 600 and belong to the invoking user'
[[ -d "$task_mount/repo/.git" || -f "$task_mount/repo/.git" ]] \
    || fail "no checkout at $task_mount/repo"

# Docker env files contain literal values. Never source/eval their contents,
# and require assignments so a bare name cannot inherit a host environment value.
task_image=''
task_image_count=0
task_line_number=0
while IFS= read -r task_line || [[ -n "$task_line" ]]; do
    ((task_line_number += 1))
    [[ "$task_line" =~ ^[[:space:]]*(#|$) ]] && continue
    [[ "$task_line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] \
        || fail "invalid env-file assignment at line $task_line_number"
    if [[ "${BASH_REMATCH[1]}" == FACTORY_IMAGE ]]; then
        task_image=${BASH_REMATCH[2]}
        ((task_image_count += 1))
    fi
done < "$task_env_file"
[[ "$task_image_count" == 1 ]] || fail 'env file must contain exactly one FACTORY_IMAGE'
[[ "$task_image" =~ ^[a-z0-9][A-Za-z0-9._/@:-]*$ ]] \
    || fail 'FACTORY_IMAGE must be one unquoted image reference without spaces'

task_docker_args=(run --rm --init --user "${task_uid}:${task_gid}"
    --env-file "$task_env_file" --env HOME=/tmp/factory-home
    --tmpfs /tmp:rw,nosuid,nodev,mode=1777
    --mount "type=bind,src=${task_mount},dst=/work"
    --workdir /work/repo)
if [[ -t 0 && -t 1 ]]; then
    task_docker_args+=(-it)
fi
exec docker "${task_docker_args[@]}" "$task_image" factory "$@"
