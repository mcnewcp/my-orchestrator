# Copy to .env beside compose.yaml; keep .env out of Git.
# Use the digest printed by the release workflow, not a mutable tag.
FACTORY_IMAGE=ghcr.io/mcnewcp/my-orchestrator@sha256:REPLACE_WITH_RELEASE_DIGEST

# Absolute host directory, writable by the image's factory uid/gid (default 1000:1000).
# It contains target/ and persistent runs/ worktrees, documents, and logs.
FACTORY_WORKSPACE=/home/operator/factory-workspace
FACTORY_CONFIG_FILE=./factory.toml

# Generate a URL-safe value with: openssl rand -hex 24
FACTORY_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX

# Dedicated writable native subscription auth directories; log in inside the image.
FACTORY_CODEX_AUTH=./.auth/codex
FACTORY_CLAUDE_AUTH=./.auth/claude
FACTORY_GH_AUTH=./.auth/gh

# Optional gh credential; alternatively use native gh auth login and the mount above.
GH_TOKEN=

# The host wrapper locates this checkout itself, including through a symlink.
# Export FACTORY_DEPLOYMENT_DIR=/absolute/deployment/path to choose another deployment.
# Compose derives internal FACTORY_DATABASE_URL, FACTORY_CONFIG, and FACTORY_IMAGE_ID.
